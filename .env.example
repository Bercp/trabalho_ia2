# Os PDFs, vetores e embeddings permanecem na máquina.
LLM_PROVIDER=openai_compatible
# Preencha com o endpoint de sua API, incluindo /v1 quando aplicável.
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=2048
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
TOP_K=5
MIN_SIMILARITY=0.45
CHUNK_SIZE=110
CHUNK_OVERLAP=20
